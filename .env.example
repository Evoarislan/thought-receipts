# Thought Receipts environment. Copy to .env and fill in real values.
# Never commit .env; only this placeholder file belongs in git.

# Optional. When set, the Why box drafts answers with real Nemotron models
# via OpenRouter (drafts are verified against the cited receipts before
# being shown), and the evaluator step adds a model critique of the
# recommendation. Without it, the Why box uses built-in template answers,
# the evaluator runs its deterministic checks only, and the demo runs with
# zero API keys.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Sample mode: "true" makes the server fully offline. No external network
# calls are made at all (model calls are refused even if a key is set);
# reasoning, Why answers, and the evaluator checks use the deterministic
# path over the bundled sample data. For judges without API keys.
# Default "false": the model path is used when OPENROUTER_API_KEY is set.
SAMPLE_MODE=false

# Payment mode: "true" (default) simulates x402 payments. Set to "false"
# for live mode, which signs real EIP-3009 authorizations on Base Sepolia.
MOCK=true

# Live mode only: Base Sepolia private key used to sign authorizations.
PRIVATE_KEY=your-base-sepolia-private-key-here

# Live mode only: address that receives the signed authorizations.
# Defaults to the signing account's own address when unset.
PAYEE_ADDRESS=0x0000000000000000000000000000000000000000

# HTTP port for the server.
PORT=3003
