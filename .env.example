# Thought Receipts environment. Copy to .env and fill in real values.
# Never commit .env; only this placeholder file belongs in git.

# Primary model provider (optional): NVIDIA Nemotron through Meterless,
# an OpenAI-compatible endpoint. When METERLESS_BASE_URL and
# METERLESS_API_KEY are set, model calls go to
# {METERLESS_BASE_URL}/chat/completions: the evaluator step adds a model
# critique of the recommendation, and the Why box drafts answers with the
# model (drafts are verified against the cited receipts before being
# shown). Results record the provider and the exact model id that
# answered. The base URL includes the /v1 prefix.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=your-meterless-api-key-here

# The Nemotron model id Meterless is asked to run. Set it to the model
# your Meterless setup serves.
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Fallback model provider (optional). Used when Meterless is not
# configured or is unreachable. When set, the Why box drafts answers with
# real Nemotron models via OpenRouter, and the evaluator step adds a
# model critique of the recommendation. Without any provider configured,
# the Why box uses built-in template answers, the evaluator runs its
# deterministic checks only, and the demo runs with zero API keys.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Data layer (optional): Zetaris live SQL. When ZETARIS_BASE_URL points
# at a Zetaris instance, the pipeline's data steps run SQL against it
# (the catalog join and the terms query in src/zetaris.ts) and their
# receipts record the query, the returned rows, and dataSource
# "zetaris". When it is unset, when SAMPLE_MODE is on, or when the
# instance errors, the same steps serve the bundled CSV sources under
# data/ and the receipts record dataSource "csv-fallback". The local
# install's REST API listens on port 8888. The managed cluster's exact
# SQL endpoint contract is not public yet, so the path and auth stay
# configurable here; see the header comment in src/zetaris.ts.
ZETARIS_BASE_URL=
# SQL endpoint path on the instance (default "/api/sql").
ZETARIS_SQL_PATH=/api/sql
# Basic-auth credentials, when the instance requires them.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Override for the bundled CSV folder (offline path). Defaults to the
# repo's data/ folder.
ZETARIS_DATA_DIR=

# Sample mode: "true" makes the server fully offline. No external network
# calls are made at all (model calls are refused even if provider keys
# are set); reasoning, Why answers, and the evaluator checks use the
# deterministic path over the bundled sample data. For judges without
# API keys.
# Default "false": the model path is used when a provider is configured
# (Meterless first, then OpenRouter).
SAMPLE_MODE=false

# Payment mode: "true" (default) simulates x402 payments. Set to "false"
# for live mode, which signs real EIP-3009 authorizations on Base Sepolia.
MOCK=true

# Live mode only: Base Sepolia private key used to sign authorizations.
PRIVATE_KEY=your-base-sepolia-private-key-here

# Live mode only: address that receives the signed authorizations.
# Defaults to the signing account's own address when unset.
PAYEE_ADDRESS=0x0000000000000000000000000000000000000000

# HTTP port for the server.
PORT=3003
